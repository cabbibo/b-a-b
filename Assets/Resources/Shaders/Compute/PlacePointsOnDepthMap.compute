// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel PlaceOnDepth

struct Vert
{
    float3 pos;
    float3 vel;
    float3 nor;
    float3 color;
    float2 uv;
    float  life;
    float  debug;
};

RWStructuredBuffer<Vert> _VertBuffer;
int                      _VertBuffer_COUNT;


int safeID( int id , int max )
{
    return clamp( id , 0 , max );
}


float4x4 _CameraViewMatrix;
float4x4 _CameraViewMatrixInverse;
float4x4 _CameraProjectionMatrix;
float4x4 _CameraProjectionMatrixInverse;

float3 _CameraPosition;

Texture2D<float4> _DepthTexture;
SamplerState      sampler_DepthTexture;
SamplerState      trilinear_clamp_sampler;


Texture2D<float4> _ColorTexture;
SamplerState      sampler_ColorTexture;

float _CameraNear;
float _CameraFar;


#include "../Chunks/snoise.cginc"
#include "../Chunks/curlNoise.cginc"

float hash11( float p )
{
    p = frac( p * .1031 );
    p *= p + 33.33;
    p *= p + p;
    return frac( p );
}

float2 hash21( float p )
{
    float3 p3 = frac( p * float3( .1031 , .1030 , .0973 ) );
    p3 += dot( p3 , p3.yzx + 33.33 );
    return frac( ( p3.xx + p3.yz ) * p3.zy );

}

float _Time;


struct Wren
{
    float3 pos;
    float3 vel;
    float  l1;
    float  r1;
    float  hue1;
    float  hue2;
    float  hue3;
    float  hue4;
};

RWStructuredBuffer<Wren> _WrenBuffer;

int _NumWrens;

float _SplatSpeed;
float _NormalOffset;

float3 getWorldPos( float2 coordinates )
{

    float  depthSample = _DepthTexture.SampleLevel( sampler_DepthTexture , coordinates , 0 ).r;
    float4 clipSpace2  = float4( coordinates * 2.0 - 1.0 , ( 1 - depthSample ) * 2 - 1 , 1.0 );
    float4 viewSpace   = mul( _CameraProjectionMatrixInverse , clipSpace2 );
    viewSpace /= viewSpace.w;

    float4 worldPos = mul( _CameraViewMatrixInverse , viewSpace );

    return worldPos.xyz;


}

float3 VecToRay( float3 ro , float3 rd , float3 pos )
{

    float3 p2      = ro - rd * 200;
    float3 pa      = pos - ro;
    float3 ba      = ro - p2;
    float  h       = dot( pa , ba ) / dot( ba , ba );
    float3 pOnLine = h * rd * 200 + ro;

    float3 inLine = pos - pOnLine;

    return inLine;
}


float2 hashwithoutsine21( float p )
{
    float3 p3 = frac( float3( p , p , p ) * float3( .1031 , .1030 , .0973 ) );
    p3 += dot( p3 , p3.yzx + 33.33 );
    return frac( ( p3.xx + p3.yz ) * p3.zy );
}

float _CurlSize;
float _CurlForce;
float _NormalForce;

// > 1 = more particles toward screen center (try 2.0)
float _CenterBias;
// hard exclusion zone at each edge — 0% chance (try 0.02)
float _BorderMargin;
// fade band just inside the hard margin — probability ramps 0→1 over this width (try 0.08)
float _FadeMargin;

// Bijective integer hash — scrambles pID so adjacent IDs land in unrelated cells
uint wangHash( uint x )
{
    x = ( x ^ 61u ) ^ ( x >> 16u );
    x *= 9u;
    x ^= x >> 4u;
    x *= 0x27d4eb2du;
    x ^= x >> 15u;
    return x;
}

// Stratified UV with scrambled cell order and rectangular center bias.
// Each particle owns one tile of a sqrt(N)×sqrt(N) grid. Wang hash scrambles
// which tile it owns so the ordering is visually incoherent. Jitter within
// the tile adds per-respawn noise. Center bias uses Chebyshev distance so
// iso-density curves are rectangles matching the screen shape.
float2 stratifiedUV( int pID , int N , float time )
{
    int gridW = max( 1 , (int)ceil( sqrt( (float)N ) ) );

    // Scramble cell assignment — breaks visible grid pattern while keeping ~1 particle per tile
    uint cellIdx = wangHash( (uint)pID ) % (uint)N;
    int  cellX   = (int)( cellIdx % (uint)gridW );
    int  cellY   = (int)( cellIdx / (uint)gridW );

    float2 jitter = hashwithoutsine21( float( pID ) + time );
    float2 uv     = ( float2( cellX , cellY ) + jitter ) / float( gridW );

    // Center bias: Chebyshev distance gives rect-shaped iso-density curves
    // so density falls off uniformly from the center point toward all edges
    float  bias = max( 1.0 , _CenterBias );
    float2 c    = uv * 2.0 - 1.0;
    float  r    = max( abs( c.x ) , abs( c.y ) );
    if ( r > 0.001 )
    {
        float rBiased = pow( r , bias );
        c             = c * ( rBiased / r );
    }
    uv = c * 0.5 + 0.5;

    return uv;
}

// Returns placement probability [0,1] for a UV based on border margin + fade margin.
// Outside hard margin: 0. Inside fade band: linear 0→1. Beyond fade band: 1.
float borderFadeProb( float2 uv )
{
    float2 dist = min( uv , 1.0 - uv ); // distance to nearest edge per axis
    float2 prob = saturate( ( dist - _BorderMargin ) / max( _FadeMargin , 0.0001 ) );
    return min( prob.x , prob.y ); // both axes must pass
}

#define NR_THREADS 128

[numthreads(NR_THREADS,1,1)]
void PlaceOnDepth( uint threadID : SV_GroupIndex , uint3 u3GroupID : SV_GroupID )
{

    int pID = threadID + u3GroupID.x * NR_THREADS;


    if ( pID < _VertBuffer_COUNT )
    {

        int  sID = safeID( pID , _VertBuffer_COUNT );
        Vert v   = _VertBuffer[ sID ];

        float4 currentViewPosition        = mul( _CameraViewMatrix , float4( v.pos , 1.0 ) );
        float4 currentScreenSpacePosition = mul( _CameraProjectionMatrix , currentViewPosition );
        currentScreenSpacePosition /= currentScreenSpacePosition.w;

        currentScreenSpacePosition /= 2.;
        currentScreenSpacePosition += .5;


        if ( currentScreenSpacePosition.x < 0 || currentScreenSpacePosition.x > 1 || currentScreenSpacePosition.y < 0 || currentScreenSpacePosition.y > 1 )
        {
            v.life -= .1;
        }

        if ( v.life < 0 )
        {

            float2 coordinates = stratifiedUV( pID , _VertBuffer_COUNT , _Time );

            // Border fade: reject spawns near the edge probabilistically.
            // At the hard margin edge → 0% chance; at inner edge of fade band → 100%.
            float prob = borderFadeProb( coordinates );
            float roll = hashwithoutsine21( float( pID ) * 17.43 + _Time * 53.17 ).x;
            if ( roll > prob )
            {
                _VertBuffer[ sID ] = v;
                return;
            }

            float depth = _DepthTexture.SampleLevel( sampler_DepthTexture , coordinates , 0 ).r;

            if ( depth < -1 )
            {
                v.uv.y = -1;

                v.color = _ColorTexture.SampleLevel( sampler_ColorTexture , coordinates , 0 ).rgb;
            }
            else
            {

                v.pos = getWorldPos( coordinates );

                if ( length( v.pos - _CameraPosition ) > _CameraFar * .95 )
                {
                    v.pos = _CameraPosition + normalize( v.pos - _CameraPosition ) * _CameraFar * .95;
                }

                float3 dX = getWorldPos( coordinates + float2( .001 , 0 ) ) - getWorldPos( coordinates - float2( .001 , 0 ) );
                float3 dY = getWorldPos( coordinates + float2( 0 , .001 ) ) - getWorldPos( coordinates - float2( 0 , .001 ) );

                v.nor = -normalize( cross( dX * 100 , dY * 100 ) );
                v.pos += v.nor * _NormalOffset;

                if ( dot( v.nor , float3( 0 , 1 , 0 ) ) < -1 )
                {
                    v.life = -1;
                    v.pos  = 100000;

                    v.color = _ColorTexture.SampleLevel( sampler_ColorTexture , coordinates , 0 ).rgb;

                }
                else
                {

                    v.color = _ColorTexture.SampleLevel( sampler_ColorTexture , coordinates , 0 ).rgb;

                    v.debug = saturate( ( max( abs( coordinates.x - .5 ) * 2 , abs( coordinates.y - .5 ) * 2 ) - .6 ) * 2.5 );
                    v.uv.y  = 1;
                    // Randomise starting life so each respawn cycle further desynchronises
                    // particles — prevents waves of simultaneous deaths rebuilding over time
                    v.life = 0.4 + 0.6 * hash11( float( pID * 7919 ) + _Time );

                }

            }

        }
        else
        {

            float3 force = float3( 0 , 0 , 0 );
            force += curlNoise( v.pos * _CurlSize ) * _CurlForce;
            force += v.nor * _NormalForce;
            v.vel += force * .001;

            v.pos += v.vel;
            v.vel *= .95;

            // Reproject toward the actual surface when the particle has drifted
            float4 pClip = mul( _CameraProjectionMatrix , mul( _CameraViewMatrix , float4( v.pos , 1.0 ) ) );
            if ( pClip.w > 0 )
            {
                float2 pUV = ( pClip.xy / pClip.w ) * 0.5 + 0.5;
                if ( pUV.x >= 0 && pUV.x <= 1 && pUV.y >= 0 && pUV.y <= 1 )
                {
                    float3 surfacePos   = getWorldPos( pUV );
                    float  displacement = length( v.pos - surfacePos );
                    // Lerp strength scales with displacement: gentle when close, strong when far
                    float  lerpT        = saturate( displacement / 3.0 ) * 0.15;
                    v.pos = lerp( v.pos , surfacePos , lerpT );
                    v.vel *= ( 1.0 - lerpT );
                }
            }
        }

        v.life -= _SplatSpeed * .001 * ( hash11( float( pID * 31 ) ) + .3 );
        v.life -= _SplatSpeed * .001 * ( hash11( float( pID * 51 ) ) + .3 );
        v.life -= _SplatSpeed * .001 * ( hash11( float( pID * 91 ) ) + .3 );


        _VertBuffer[ sID ] = v;
    }

}
